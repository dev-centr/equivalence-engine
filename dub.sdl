name "equivalence-engine"
description "Core engine for the Equivalence Adaptation Ecosystem (dev-centr)."
authors "dev-centr"
copyright "Copyright © 2026, dev-centr"
license "MIT"
dependency "sdlang-d" version="~>0.10.6"
dependency "repo-get" version="~>0.2.1"
// Sibling checkout in CI (see .github/workflows/ci.yml). Git pin after libequivalence is tagged.
dependency "libequivalence" path="../libequivalence"
targetType "executable"
targetPath "bin"
mainSourceFile "source/app.d"
